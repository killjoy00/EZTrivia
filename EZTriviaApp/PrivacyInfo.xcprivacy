<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- The app ships no analytics or crash-reporting SDK and collects nothing
	     itself. GoogleMobileAds declares its own collection in the privacy
	     manifest bundled with that SDK; Apple aggregates the two at submission. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- ScoreStore keeps the local leaderboard and the seen-question set in
		     UserDefaults. CA92.1 is the "accessing information from the app
		     itself" reason. Without this entry App Store Connect rejects the
		     upload with ITMS-91053. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
