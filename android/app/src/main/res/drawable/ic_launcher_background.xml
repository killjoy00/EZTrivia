<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon's ground, redrawn as a vector so the background layer fills
     the full 108dp adaptive canvas at any density. Endpoints are sampled from
     AppIcon-1024.png; Scripts/make_android_icons.py uses the same pair. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#2D2391"
        android:endColor="#622DB4"
        android:type="linear" />
</shape>
