# Android signing material must never be committed. Release signing is supplied
# to GitHub Actions through repository secrets.
*.jks
*.keystore
*.p12
android/keystore.properties

# Firebase Android configuration is materialized by the signed release workflow
# from FIREBASE_GOOGLE_SERVICES_JSON once Crashlytics is provisioned.
android/app/google-services.json
